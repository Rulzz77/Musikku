<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/musikku_widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MUSIKKU PLAYER"
        android:textColor="#FFB8C7DD"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Belum ada lagu"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Putar musik di MusikKu"
            android:textColor="#FFB8C7DD"
            android:textSize="10sp" />
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Sebelumnya"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFFFF" />
        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:contentDescription="Putar atau jeda"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFFFF" />
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Berikutnya"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
