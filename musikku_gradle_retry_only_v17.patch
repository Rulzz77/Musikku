diff --git a/.github/workflows/auto-release.yml b/.github/workflows/auto-release.yml
--- a/.github/workflows/auto-release.yml
+++ b/.github/workflows/auto-release.yml
@@ -237,14 +237,54 @@
           if [[ "$SUPABASE_URL" != https://* ]]; then
             echo "::error::SUPABASE_URL must start with https://."
             exit 1
           fi
 
-          flutter build apk --release \
-            --dart-define="YOUTUBE_API_KEY=${YOUTUBE_API_KEY}" \
-            --dart-define="SUPABASE_URL=${SUPABASE_URL}" \
-            --dart-define="SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}"
+          # Retry only transient repository/network failures. Do not hide real
+          # Dart, Kotlin, Android, or resource compilation errors behind retries.
+          BUILD_SUCCEEDED=0
+          LAST_BUILD_LOG="${RUNNER_TEMP}/musikku-release-build.log"
+
+          for attempt in 1 2 3; do
+            LAST_BUILD_LOG="${RUNNER_TEMP}/musikku-release-build-${attempt}.log"
+            echo "Starting release build (attempt ${attempt}/3)..."
+
+            set +e
+            flutter build apk --release \
+              --dart-define="YOUTUBE_API_KEY=${YOUTUBE_API_KEY}" \
+              --dart-define="SUPABASE_URL=${SUPABASE_URL}" \
+              --dart-define="SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}" \
+              2>&1 | tee "$LAST_BUILD_LOG"
+            BUILD_STATUS=${PIPESTATUS[0]}
+            set -e
+
+            if [[ "$BUILD_STATUS" -eq 0 ]]; then
+              BUILD_SUCCEEDED=1
+              break
+            fi
+
+            if grep -Eiq \
+              'Received status code (429|5[0-9][0-9])|Gateway Time-out|Bad Gateway|Service Unavailable|Read timed out|Connection reset|UnknownHostException|Temporary failure in name resolution|Connection refused' \
+              "$LAST_BUILD_LOG"; then
+              if [[ "$attempt" -lt 3 ]]; then
+                WAIT_SECONDS=$((attempt * 30))
+                echo "::warning::Transient dependency/network failure. Retrying in ${WAIT_SECONDS}s..."
+                sleep "$WAIT_SECONDS"
+                continue
+              fi
+            else
+              echo "::error::Build failed for a non-transient reason; automatic retry stopped."
+              tail -n 120 "$LAST_BUILD_LOG"
+              exit "$BUILD_STATUS"
+            fi
+          done
+
+          if [[ "$BUILD_SUCCEEDED" -ne 1 ]]; then
+            echo "::error::Release build failed after 3 attempts due to repeated transient dependency/network errors."
+            tail -n 120 "$LAST_BUILD_LOG"
+            exit 1
+          fi
 
           APK="build/app/outputs/flutter-apk/app-release.apk"
           test -s "$APK"
 
           echo "APK built successfully: $APK"
